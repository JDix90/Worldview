[Unit]
Description=ORRERY status display (MHS-3.5" framebuffer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/pi/Project_Worldview/edge/pager
EnvironmentFile=/home/pi/Project_Worldview/edge/pager/pager.env
# fb device: the headless appliance's piscreen enumerates as fb0 (fb_ili9486,
# 480×320) on the Pi 5 / trixie — confirmed on hardware (DECISIONS #94). If a
# rebuild ever shows a different device, `ls /sys/class/graphics/` and adjust.
ExecStart=/home/pi/pager-venv/bin/python /home/pi/Project_Worldview/edge/pager/orrery_pager.py --fb /dev/fb0 --touch auto
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
